#########
# STARK #
#########
# Environment variables used within container/service

# API refresh interval in seconds (default: 10 seconds)
STARK_API_REFRESH_INTERVAL=60

# Production: Launch tab desactivated
STARK_API_LAUNCH_ENABLED=false

# # Devel: everything open
# STARK_API_LAUNCH_ENABLED=true
# STARK_API_LAUNCH_MODES=

# # Custom: Only RUN tab enabled
# STARK_API_LAUNCH_ENABLED=true
# # STARK_API_LAUNCH_MODES=run,docker,advanced
# STARK_API_LAUNCH_MODES=run

# Proxy
http_proxy=
