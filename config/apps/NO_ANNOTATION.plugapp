#!/bin/bash
## STARK application NO_ANNOTATION

# DEFAULT ENV
######################
#source $CONFIG_DEFAULT_APP

# APPLICATION INFOS
#####################
APP_NAME="NO_ANNOTATION"
APP_RELEASE="1.0"
APP_DESCRIPTION="PlugAPP to disable annotation and minimalize calculation, but keep prioritization (if defined)"
