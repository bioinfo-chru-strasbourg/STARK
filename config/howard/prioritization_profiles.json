{
  "default": {
    "_description": "Default prioritization profile",
    "_version": "1.0.0",
    "Quality": [
      {
      "sql": " QUAL >= 30 and (regexp_matches(FILTER, 'PASS') or FILTER = '.')",
        "fields": ["QUAL", "FILTER"],
        "score": 10,
        "flag": "PASS",
        "class": "GOOD_QUAL",
        "comment": [
          "Quality is good (QUAL >= 30 and PASS)"
        ]
      },
      {
        "sql": " QUAL < 30 or NOT (regexp_matches(FILTER, 'PASS') or FILTER = '.')",
        "fields": ["QUAL", "FILTER"],
        "score": -10,
        "flag": "FILTERED",
        "class": "BAD_QUAL",
        "comment": [
          "Quality is poor (QUAL < 30 or FILTER not 'PASS')"
        ]
      }
    ],
    "snpeff_AnnotationImpact": [
      {
        "sql": " regexp_matches(snpeff_AnnotationImpact, 'MODIFIER') ",
        "fields": ["snpeff_AnnotationImpact"],
        "score": 100,
        "flag": "PASS",
        "class": "MODIFIER",
        "comment": [
          "Annotated as modifier in snpEff"
        ]
      }
    ]
  }
}
