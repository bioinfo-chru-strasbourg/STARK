{
  "default": {
    "_description": "Default prioritization profile",
    "_version": "1.0.0",
    "Quality": [
      {
      "sql": " (QUAL::VARCHAR = '.' or TRY_CAST(QUAL::VARCHAR AS INTEGER) >= 30) and (regexp_matches(FILTER::VARCHAR, 'PASS') or FILTER::VARCHAR = '.')",
        "fields": ["QUAL", "FILTER"],
        "score": 10,
        "flag": "PASS",
        "class": "GOOD_QUAL",
        "comment": [
          "Quality is good (QUAL >= 30 and PASS)"
        ]
      },
      {
        "sql": " (QUAL::VARCHAR != '.' and TRY_CAST(QUAL::VARCHAR AS INTEGER) < 30) or NOT (regexp_matches(FILTER::VARCHAR, 'PASS') or FILTER::VARCHAR = '.')",
        "fields": ["QUAL", "FILTER"],
        "score": -10,
        "flag": "FILTERED",
        "class": "BAD_QUAL",
        "comment": [
          "Quality is poor (QUAL < 30 or FILTER not 'PASS')"
        ]
      }
    ],
    "snpeff_AnnotationImpact": [
      {
        "sql": " regexp_matches(snpeff_AnnotationImpact::VARCHAR, 'HIGH') ",
        "fields": ["snpeff_AnnotationImpact"],
        "score": 20,
        "flag": "PASS",
        "class": "HIGH",
        "comment": [
          "Annotated as high impact in snpEff"
        ]
      },
      {
        "sql": " regexp_matches(snpeff_AnnotationImpact::VARCHAR, 'MODERATE') ",
        "fields": ["snpeff_AnnotationImpact"],
        "score": 10,
        "flag": "PASS",
        "class": "MODERATE",
        "comment": [
          "Annotated as moderate impact in snpEff"
        ]
      }
    ]
  }
}
